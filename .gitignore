# Python and local environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env

# Local data: never commit a raw operational dataset without checking its licence and privacy.
# The named public sources below are intentionally versioned for reproduction.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
!data/raw/laghouat_2022/
!data/raw/laghouat_2022/Laghouat_2022_final.csv
!data/raw/zenodo_inverter_2023_2024/
!data/raw/zenodo_inverter_2023_2024/math_model_all_inverters_03.11.2023-25.06.2024.csv
!data/raw/dhaka_2019_2020/
!data/raw/dhaka_2019_2020/Solar Dataset.zip
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated models, charts and run outputs
artifacts/*
!artifacts/.gitkeep

# Local audit reproductions
audit_reproduction_*/
audit_dhaka_extraction*/
audit_dhaka_artifacts*/

# The article is maintained exclusively in Overleaf.
article/

# Editors and LaTeX auxiliary files
.vscode/
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz

# Temporary directories created by the test suite
.pytest-tmp*/
